{
  "name": "@b2b/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:build": "tsc -w -p tsconfig.build.json --preserveWatchOutput",
    "dev:api": "node --watch --env-file-if-exists=../../.env dist/main.js",
    "dev:worker": "node --watch --env-file-if-exists=../../.env dist/worker.main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.main.js",
    "typecheck": "pnpm --filter @b2b/shared build && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:isolation": "vitest run --config vitest.integration.config.mts isolation",
    "db:bootstrap": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/cli.js db:bootstrap",
    "db:migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/cli.js db:migrate",
    "check-rls": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/cli.js check-rls"
  },
  "dependencies": {
    "@b2b/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "bullmq": "5.81.5",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@b2b/config": "workspace:*",
    "@nestjs/testing": "11.2.8",
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1"
  }
}
