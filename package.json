{
  "name": "b2b-platform",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.34.8"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @b2b/api --filter @b2b/web dev",
    "lint": "pnpm --filter @b2b/shared build && eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "pnpm -r test && vitest run",
    "test:coverage": "pnpm -r --filter @b2b/api --filter @b2b/shared --filter @b2b/web test --coverage",
    "build": "pnpm -r build",
    "test:integration": "pnpm --filter @b2b/shared build && pnpm --filter @b2b/api test:integration",
    "test:isolation": "pnpm --filter @b2b/shared build && pnpm --filter @b2b/api test:isolation",
    "db:bootstrap": "pnpm --filter @b2b/shared build && pnpm --filter @b2b/api db:bootstrap",
    "db:migrate": "pnpm --filter @b2b/shared build && pnpm --filter @b2b/api db:migrate",
    "check-rls": "pnpm --filter @b2b/shared build && pnpm --filter @b2b/api check-rls"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.7"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  },
  "devDependencies": {
    "@b2b/config": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
