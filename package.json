{
  "name": "b2b-platform",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.34.8"
  },
  "scripts": {
    "dev": "pnpm --filter @b2b/api dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "pnpm -r test && vitest run",
    "build": "pnpm -r build"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.7"
    }
  },
  "devDependencies": {
    "@b2b/config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
