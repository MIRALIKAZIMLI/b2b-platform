# Yerel geliştirme için örnek değerler. Kopyala: cp .env.example .env
# Buradaki değerler sahtedir; gerçek anahtar bu dosyaya yazılmaz.

APP_ENV=local

# API dinleme portu
PORT=3000

# Log seviyesi: fatal, error, warn, info, debug, trace, silent (varsayılan info)
LOG_LEVEL=info

# infra/docker-compose.dev.yml
POSTGRES_USER=b2b
POSTGRES_PASSWORD=b2b_local_password
POSTGRES_DB=b2b
MEILI_MASTER_KEY=local_meili_master_key_change_me

# Bilgisayardaki portlar (dolu bir portu değiştirmek için)
POSTGRES_PORT=5432
REDIS_PORT=6379
MEILI_PORT=7700

# Veritabanı (apps/api). Kullanıcı adları sabittir: app_user ve migrator.
# Şifreler yalnızca yerel örnektir; `pnpm db:bootstrap` bunları rollere atar.
# Bootstrap süper kullanıcı olarak yukarıdaki POSTGRES_USER / POSTGRES_PASSWORD ile bağlanır.
# POSTGRES_PORT'u değiştirdiysen aşağıdaki iki adresteki portu da değiştir.
DATABASE_URL=postgres://app_user:local_app_user_password@127.0.0.1:5432/b2b
DATABASE_MIGRATOR_URL=postgres://migrator:local_migrator_password@127.0.0.1:5432/b2b
DB_POOL_MAX=10

# Redis (infra/docker-compose.dev.yml). REDIS_PORT'u değiştirdiysen buradaki portu da değiştir.
REDIS_URL=redis://127.0.0.1:6379

# SMS (apps/api). Yerelde ve staging'de yalnızca mock: SMS gönderilmez, kod
# GET /api/v1/dev/sms-outbox adresinde görünür. Production'da mock ile api açılmaz.
SMS_PROVIDER=mock

# OTP kod özeti anahtarı (en az 32 karakter). Bu değer sahtedir; kendi .env dosyanda
# rastgele bir değer kullan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HASH_KEY=local_only_change_me_otp_hash_key_0000000000
